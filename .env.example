# LLM provider: "anthropic" (real API) or "mock" (deterministic, no key needed).
# Tests, CI and E2E always run on mock. When unset, the app picks anthropic
# if any credential is available, otherwise mock.
LLM_PROVIDER=anthropic

# Credentials — any ONE of the following (resolved in this order):
#
# 1. API key:
#    ANTHROPIC_API_KEY=your-api-key-here
#
# 2. OAuth bearer token (short-lived; mint via `ant auth print-credentials`):
#    ANTHROPIC_AUTH_TOKEN=your-oauth-token-here
#
# 3. Nothing — if you've run `ant auth login`, the app mints and refreshes
#    short-lived OAuth tokens from your ant profile automatically.

# Optional: SQLite location (default: data/app.sqlite, gitignored).
# DATABASE_PATH=data/app.sqlite
