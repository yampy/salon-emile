# LLM provider: "claude-code" | "anthropic" | "mock"
#
#   claude-code — via the Claude Agent SDK, sharing Claude Code's login.
#                 Runs on your Claude Pro/Max subscription (local personal
#                 use). Requires a logged-in Claude Code on this machine.
#   anthropic   — direct API (billed as API usage). Credentials resolve as:
#                 ANTHROPIC_API_KEY → ANTHROPIC_AUTH_TOKEN → `ant auth login`
#                 profile (short-lived OAuth tokens, minted automatically).
#   mock        — deterministic, no credentials. Tests/CI/E2E always use this.
#
# When unset, the app picks anthropic if an API credential is available,
# otherwise mock.
LLM_PROVIDER=claude-code

# Only for LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_AUTH_TOKEN=your-oauth-token-here

# Optional: SQLite location (default: data/app.sqlite, gitignored).
# DATABASE_PATH=data/app.sqlite
